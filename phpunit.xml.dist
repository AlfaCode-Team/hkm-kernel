<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!--
            Feature: boots a real kernel and pushes a real Request through the
            real HttpPipeline. Catches the class of defect a unit test cannot —
            a controller signature the stage no longer matches, a route that
            resolves to nothing, a binding that is not reachable from the scope
            that needs it.
        -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Modules: the first-party packages under modules/ that carry their own
            tests. They are listed here because this file is what CI runs, and a
            package whose suite is in no testsuite is a package whose tests never
            fail — the one state that looks exactly like passing.

            modules/ground is deliberately NOT here yet: its suite boots real
            kernels and takes ~67s, so adding it is a CI-time decision of its own
            rather than a side effect of listing these three.
        -->
        <testsuite name="Modules">
            <directory>modules/pools/tests</directory>
            <directory>modules/openapi/tests</directory>
            <directory>modules/circuit-breaker/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
            <directory suffix=".php">plugins</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
</phpunit>
