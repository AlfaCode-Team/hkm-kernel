parameters:
    level: 5
    paths:
        - src
        - projects
    # `plugins` was removed when the kernel stopped shipping them (they live in
    # their own repositories now and are fetched with `hkm plugins install`).
    # The path stayed in this list, so every run since has failed with
    # "Path .../plugins does not exist" before analysing a single file.
    scanDirectories:
        - modules
    excludePaths:
        - */vendor/*
        - */__dev__/*
        - projects/*/var/*
        - projects/*/userdata/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    # Optional Swoole/OpenSwoole coroutine calls — runtime-guarded by
    # class_exists()/method_exists(); the extension is absent in CI, so PHPStan
    # cannot verify them statically. Behaviour is correct at runtime.
    ignoreErrors:
        - '#static method (Swoole|OpenSwoole)\\Coroutine::(usleep|getCid)\(\)#'
        - "#function (method_exists|class_exists)\\(\\) with .*(Swoole|OpenSwoole).* will always evaluate to false#"

includes:
    - phpstan-baseline.neon
